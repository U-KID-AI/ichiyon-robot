{
  "format_version": "1.26.30",
  "minecraft:entity": {
    "description": {"identifier": "ichiyon:garbage_molcar", "is_spawnable": true, "is_summonable": true, "is_experimental": false,
      "properties": {"ichiyon:pickup_enabled": {"type": "bool", "default": false}}},
    "component_groups": {
      "ichiyon:garbage_idle": {
        "minecraft:behavior.random_stroll": {"priority": 6, "speed_multiplier": 1, "interval": 40},
        "minecraft:behavior.random_look_around": {"priority": 8}
      },
      "ichiyon:garbage_follow": {
        "minecraft:tameable": {"probability": 0, "tame_items": []},
        "minecraft:is_tamed": {}
      },
      "ichiyon:garbage_following": {
        "minecraft:behavior.follow_owner": {"priority": 2, "speed_multiplier": 1.2, "start_distance": 3, "stop_distance": 2, "can_teleport": false}
      }
    },
    "components": {
      "minecraft:type_family": {"family": ["garbage_molcar", "mob"]},
      "minecraft:health": {"value": 30, "max": 30},
      "minecraft:collision_box": {"width": 1.5, "height": 1.25},
      "minecraft:movement": {"value": 0.24},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {"avoid_water": true, "can_jump": true},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:behavior.float": {"priority": 0},
      "minecraft:inventory": {"inventory_size": 54, "container_type": "inventory", "private": true, "can_be_siphoned_from": false},
      "minecraft:persistent": {},
      "minecraft:nameable": {},
      "minecraft:leashable": {"presets": [{"soft_distance": 4, "hard_distance": 6, "max_distance": 12}]},
      "minecraft:interact": {"interactions": [{
        "interact_text": "action.interact.ichiyon_garbage_molcar",
        "on_interact": {"filters": {"all_of": [
          {"test": "is_family", "subject": "other", "value": "player"},
          {"test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:air"}
        ]}}
      }]}
    },
    "events": {
      "minecraft:entity_spawned": {"add": {"component_groups": ["ichiyon:garbage_idle"]}},
      "ichiyon:garbage_pickup_on": {"remove": {"component_groups": ["ichiyon:garbage_idle", "ichiyon:garbage_following"]}, "set_property": {"ichiyon:pickup_enabled": true}},
      "ichiyon:garbage_pickup_off": {"sequence": [
        {"set_property": {"ichiyon:pickup_enabled": false}},
        {"filters": {"test": "is_tamed", "value": true}, "add": {"component_groups": ["ichiyon:garbage_following"]}},
        {"filters": {"test": "is_tamed", "value": false}, "add": {"component_groups": ["ichiyon:garbage_idle"]}}
      ]},
      "ichiyon:garbage_start": {"remove": {"component_groups": ["ichiyon:garbage_idle"]}, "add": {"component_groups": ["ichiyon:garbage_follow", "ichiyon:garbage_following"]}, "set_property": {"ichiyon:pickup_enabled": false}},
      "ichiyon:garbage_stop": {"remove": {"component_groups": ["ichiyon:garbage_follow", "ichiyon:garbage_following"]}, "add": {"component_groups": ["ichiyon:garbage_idle"]}, "set_property": {"ichiyon:pickup_enabled": false}}
    }
  }
}
