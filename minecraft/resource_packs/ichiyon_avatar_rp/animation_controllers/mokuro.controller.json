{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mokuro.state": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {"glide": "query.property('ichiyon:gliding')"},
            {"walk": "!query.property('ichiyon:carried') && query.modified_move_speed > 0.01"}
          ]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [{"idle": "query.property('ichiyon:carried') || query.modified_move_speed <= 0.01"}]
        },
        "glide": {
          "animations": ["open_wings"],
          "transitions": [{"idle": "!query.property('ichiyon:gliding')"}]
        }
      }
    }
  }
}
