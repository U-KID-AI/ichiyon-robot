      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "ignore_lighting": true,
      "textures": [
        "Array.frames[math.floor(math.max(0, q.property('ichiyon:frame')) / 100)]"
