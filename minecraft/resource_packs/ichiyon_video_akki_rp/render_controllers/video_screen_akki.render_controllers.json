{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ichiyon_video_akki_black": {
      "geometry": "Geometry.black",
      "materials": [
        {
          "*": "Material.black"
        }
      ],
      "textures": [
        "Texture.black"
      ],
      "ignore_lighting": true
    },
    "controller.render.ichiyon_video_screen_akki": {
      "arrays": {
        "textures": {
          "Array.frames": [
            "Texture.atlas_0",
            "Texture.atlas_1",
            "Texture.atlas_2"
          ]
