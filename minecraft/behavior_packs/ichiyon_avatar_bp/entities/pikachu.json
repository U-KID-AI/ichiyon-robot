{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "ichiyon:pikachu",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "ichiyon:spin": {
          "type": "int",
          "range": [
            -1,
            1
          ],
          "default": 0,
          "client_sync": true
        },
        "ichiyon:spin_busy": {
          "type": "bool",
          "default": false
        }
      },
      "animations": {
        "spin_lifecycle": "controller.animation.pikachu.spin_lifecycle"
      },
      "scripts": {
        "animate": [
          "spin_lifecycle"
        ]
      }
    },
    "component_groups": {
      "ichiyon:mobile": {
        "minecraft:movement": {
          "value": 0.16
        },
        "minecraft:physics": {
          "has_gravity": true,
          "has_collision": true
        },
        "minecraft:behavior.float": {
          "priority": 0
        },
        "minecraft:behavior.follow_mob": {
          "priority": 1,
          "search_range": 12,
          "speed_multiplier": 1.8,
          "stop_distance": 2.5,
          "use_home_position_restriction": false,
          "filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              {
                "test": "is_sleeping",
                "subject": "other",
                "value": true
              }
            ]
          }
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.8,
          "xz_dist": 6,
          "y_dist": 1
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        },
        "minecraft:movement.basic": {
          "max_turn": 30
        }
      },
      "ichiyon:spinning": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true,
          "push_towards_closest_space": false
        },
        "minecraft:knockback_resistance": {
          "value": 1
        },
        "minecraft:movement.basic": {
          "max_turn": 0
        }
      },
      "ichiyon:ready": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "int_property",
                      "domain": "ichiyon:spin",
                      "value": 0
                    },
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "on_ground",
                      "value": true
                    },
                    {
                      "test": "bool_property",
                      "domain": "ichiyon:spin_busy",
                      "value": false
                    }
                  ]
                },
                "event": "ichiyon:spin_start",
                "target": "self"
              },
              "cooldown": 1.2,
              "interact_text": "action.interact.ichiyon_pikachu_spin"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "pikachu",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.0
      },
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "can_path_over_water": false,
        "can_pass_doors": true,
        "can_open_doors": false,
        "can_jump": true
      },
      "minecraft:jump.static": {},
      "minecraft:nameable": {},
      "minecraft:persistent": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "ichiyon:mobile"
          ]
        }
      },
      "ichiyon:spin_start": {
        "sequence": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "int_property",
                  "domain": "ichiyon:spin",
                  "value": 0
                },
                {
                  "test": "bool_property",
                  "domain": "ichiyon:spin_busy",
                  "value": false
                }
              ]
            },
            "remove": {
              "component_groups": [
                "ichiyon:mobile",
                "ichiyon:ready"
              ]
            },
            "add": {
              "component_groups": [
                "ichiyon:spinning"
              ]
            },
            "randomize": [
              {
                "weight": 99,
                "set_property": {
                  "ichiyon:spin": 1,
                  "ichiyon:spin_busy": true
                }
              },
              {
                "weight": 1,
                "set_property": {
                  "ichiyon:spin": -1,
                  "ichiyon:spin_busy": true
                }
              }
            ]
          }
        ]
      },
      "ichiyon:spin_end": {
        "remove": {
          "component_groups": [
            "ichiyon:spinning",
            "ichiyon:ready"
          ]
        },
        "add": {
          "component_groups": [
            "ichiyon:mobile"
          ]
        },
        "set_property": {
          "ichiyon:spin": 0,
          "ichiyon:spin_busy": true
        }
      },
      "ichiyon:spin_ready": {
        "remove": {
          "component_groups": [
            "ichiyon:spinning"
          ]
        },
        "add": {
          "component_groups": [
            "ichiyon:mobile",
            "ichiyon:ready"
          ]
        },
        "set_property": {
          "ichiyon:spin": 0,
          "ichiyon:spin_busy": false
        }
      }
    }
  }
}
