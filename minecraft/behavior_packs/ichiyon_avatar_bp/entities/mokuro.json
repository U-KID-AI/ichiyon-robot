{
  "format_version": "1.26.30",
  "minecraft:entity": {
    "description": {
      "identifier": "ichiyon:mokuro",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "ichiyon:boosting": {"type": "bool", "default": false, "client_sync": true},
        "ichiyon:carried": {"type": "bool", "default": false, "client_sync": true},
        "ichiyon:gliding": {"type": "bool", "default": false, "client_sync": true}
      }
    },
    "component_groups": {
      "ichiyon:mokuro_mobile": {
        "minecraft:movement": {"value": 0.22},
        "minecraft:movement.basic": {"max_turn": 30},
        "minecraft:navigation.walk": {"avoid_water": true, "can_jump": true},
        "minecraft:jump.static": {},
        "minecraft:physics": {"has_gravity": true, "has_collision": true},
        "minecraft:pushable_by_entity": {},
        "minecraft:pushable_by_block": {},
        "minecraft:leashable": {"presets": [{"soft_distance": 4, "hard_distance": 6, "max_distance": 12}]},
        "minecraft:behavior.float": {"priority": 0},
        "minecraft:behavior.random_stroll": {"priority": 6, "speed_multiplier": 1.0, "interval": 40, "xz_dist": 6, "y_dist": 1},
        "minecraft:behavior.random_look_around": {"priority": 8}
      },
      "ichiyon:mokuro_carried": {
        "minecraft:movement": {"value": 0},
        "minecraft:physics": {"has_gravity": false, "has_collision": false},
        "minecraft:knockback_resistance": {"value": 1}
      }
    },
    "components": {
      "minecraft:type_family": {"family": ["mokuro", "mob"]},
      "minecraft:health": {"value": 20, "max": 20},
      "minecraft:collision_box": {"width": 0.75, "height": 0.875},
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:interact": {
        "interactions": [{
          "on_interact": {"filters": {"all_of": [
            {"test": "is_family", "subject": "other", "value": "player"},
            {"test": "has_equipment", "subject": "other", "domain": "hand", "value": "minecraft:air"}
          ]}},
          "interact_text": "action.interact.ichiyon_mokuro"
        }]
      }
    },
    "events": {
      "minecraft:entity_spawned": {"add": {"component_groups": ["ichiyon:mokuro_mobile"]}},
      "ichiyon:mokuro_attach": {
        "remove": {"component_groups": ["ichiyon:mokuro_mobile"]},
        "add": {"component_groups": ["ichiyon:mokuro_carried"]},
        "set_property": {"ichiyon:carried": true, "ichiyon:gliding": false, "ichiyon:boosting": false}
      },
      "ichiyon:mokuro_detach": {
        "remove": {"component_groups": ["ichiyon:mokuro_carried"]},
        "add": {"component_groups": ["ichiyon:mokuro_mobile"]},
        "set_property": {"ichiyon:carried": false, "ichiyon:gliding": false, "ichiyon:boosting": false}
      }
    }
  }
}
