{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "animations": {
        "float_ring": "animation.molcar.float_ring",
        "idle": "animation.molcar3.idle",
        "walk": "animation.molcar3.walk"
      },
      "geometry": {
        "default": "geometry.molcar3",
        "float_ring": "geometry.ichiyon.molcar3.float_ring"
      },
      "identifier": "ichiyon:molcar3",
      "materials": {
        "default": "entity_alphatest"
      },
      "render_controllers": [
        "controller.render.default",
        {
          "controller.render.ichiyon.float_ring": "query.property('ichiyon:float_ring') == 1"
        }
      ],
      "scripts": {
        "animate": [
          {
            "idle": "!query.is_moving"
          },
          {
            "walk": "query.is_moving"
          },
          {
            "float_ring": "query.property('ichiyon:float_ring') == 1 && query.is_in_water"
          }
        ]
      },
      "spawn_egg": {
        "base_color": "#967219",
        "overlay_color": "#781814"
      },
      "textures": {
        "default": "textures/entity/molcar3",
        "float_ring": "textures/entity/molcar_float_ring"
      }
    }
  }
}
