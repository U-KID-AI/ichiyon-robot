{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ichiyon:taketumi",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/taketumi"
      },
      "geometry": {
        "default": "geometry.taketumi"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "animations": {
        "idle": "animation.taketumi.idle",
        "walk": "animation.taketumi.walk",
        "attack": "animation.taketumi.attack",
        "hurt": "animation.taketumi.hurt"
      },
      "scripts": {
        "animate": [
          {
            "idle": "!query.is_moving && variable.attack_time <= 0.0 && query.hurt_time <= 0.0"
          },
          {
            "walk": "query.is_moving && variable.attack_time <= 0.0 && query.hurt_time <= 0.0"
          },
          {
            "attack": "variable.attack_time > 0.0 && query.hurt_time <= 0.0"
          },
          {
            "hurt": "query.hurt_time > 0.0"
          }
        ]
      }
    }
  }
}
