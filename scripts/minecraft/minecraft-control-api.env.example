MINECRAFT_CONTROL_SECRET=replace-with-long-random-secret
MINECRAFT_CONTROL_PROJECT_DIR=/home/ubuntu/minecraft-bedrock-creative
MINECRAFT_CONTROL_COMPOSE_SERVICE=bedrock-creative
MINECRAFT_CONTROL_CONTAINER_NAME=minecraft-bedrock-creative
MINECRAFT_CONTROL_WORLD_NAME=ichiyon-creative-flat
MINECRAFT_CONTROL_BEDROCK_PORT=19134
MINECRAFT_CONTROL_RESTART_WAIT_SECONDS=180
MINECRAFT_CONTROL_BACKUP_RETENTION=20
MINECRAFT_CONTROL_USE_SAVE_HOLD=false
